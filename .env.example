API_PORT=3001
API_HOST=127.0.0.1
VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# fixture is deterministic and the default for local development. live never
# falls back to fixture if an external provider fails.
PROVIDER_MODE=fixture

# Server-only post-capture image assessor. Keep OPENAI_API_KEY out of VITE_
# variables. Keep the selected model explicit so every test machine uses Luna.
OPENAI_API_KEY=
SHOT_ASSESSOR_MODEL=gpt-5.6-luna

# Live camera guidance uses one prewarmed OpenAI Realtime WebSocket. The
# default below is the only measured model that currently passes the required
# 20-sample p95 < 1,000ms gate; rerun the gate before changing it.
VISION_GUIDANCE_MODEL=gpt-realtime-mini
VISION_GUIDANCE_RESPONSE_TIMEOUT_SECONDS=0.90
VISION_GUIDANCE_CONNECT_TIMEOUT_SECONDS=8
VISION_GUIDANCE_PREWARM_TIMEOUT_SECONDS=8
VISION_GUIDANCE_IMAGE_MAX_EDGE=256
VISION_GUIDANCE_JPEG_QUALITY=55
VISION_GUIDANCE_MAX_OUTPUT_TOKENS=32

# The same loopback rembg sidecar serves prewarmed u2netp for live front/back
# geometry and birefnet-general-lite for post-capture transparency. The live
# geometry provider fixes its own 450ms sub-deadline and never emits READY.
REMBG_PORT=7000

# Python FastAPI / LiveKit settings. Credentials are server-only and must
# never be renamed with a VITE_ prefix.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=90
LIVEKIT_TOKEN_MAX_TTL_SECONDS=300

# Task 3.1 smoke run: one Room and two different participant identities.
LIVEKIT_ROOM=team-d-livekit-smoke
LIVEKIT_BROWSER_IDENTITY=browser-tomo-smoke
LIVEKIT_AGENT_IDENTITY=agent-guidance-smoke
LIVEKIT_TOKEN_TTL_MINUTES=10

# Browser-safe values. VITE_LIVEKIT_BROWSER_TOKEN must be short-lived.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
VITE_LIVEKIT_ROOM=team-d-livekit-smoke
VITE_LIVEKIT_BROWSER_IDENTITY=browser-tomo-smoke
VITE_LIVEKIT_AGENT_IDENTITY=agent-guidance-smoke
VITE_LIVEKIT_BROWSER_TOKEN=
