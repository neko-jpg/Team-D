{
  "name": "team-d-capture-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "npm run typecheck && vite build --config app/vite.config.ts",
    "typecheck": "tsc -p app/tsconfig.json --noEmit",
    "test": "vitest run --config app/vitest.config.ts",
    "test:watch": "vitest --config app/vitest.config.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
